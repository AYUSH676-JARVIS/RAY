# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info
RANDOM_SEED=42

# Database (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ray_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ray_db
POSTGRES_PORT=5432

# API Server
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

# Security (Development Defaults)
JWT_SECRET_KEY=ray_dev_jwt_secret_key_minimum_32_bytes_long
RAZORPAY_WEBHOOK_SECRET=rzp_dev_webhook_secret_for_local_testing_only

# Web Frontend (Canonical: NEXT_PUBLIC_API_BASE)
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
