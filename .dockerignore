# RAY — Docker Ignore Rules
# Exclude local virtual environments, build artifacts, and system files

.git
.gitignore
.github
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
apps/web/node_modules/
apps/web/.next/
apps/web/playwright-report/
apps/web/test-results/
node_modules/

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tempmediaStorage/
scratch/

# Environment files with local secrets
.env
.env.local
.env.*.local
