# ==============================================================================
# RAY Production Environment Configuration Template
# Canonical Environment Contract — Production Deployments
# Copy this template to .env.production and supply cryptographically secure values.
# Placeholder values (e.g., change_me, test, default) are strictly rejected.
# ==============================================================================

# Core Application Environment (Canonical: ENVIRONMENT)
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME="RAY Merchant Revenue Recovery Control Plane"

# PostgreSQL Authoritative Database
# Explicit, high-entropy password required. Default/insecure credentials are rejected.
POSTGRES_USER=ray_user
POSTGRES_PASSWORD=
POSTGRES_DB=ray_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# JWT Authentication & Authorization (Canonical: JWT_SECRET_KEY)
# Must be a cryptographically random secret >= 32 characters (e.g., generated with openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Webhook Cryptographic Verification (Canonical: RAZORPAY_WEBHOOK_SECRET)
# Mandatory for validating incoming HMAC-SHA256 signatures from payment gateways
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Production Gateway Credentials
# Required only if GATEWAY_MODE=razorpay_live.
# When LIVE_EXECUTION_ENABLED=false, Stage 1 Safety Guard prevents autonomous movement.
GATEWAY_MODE=razorpay_test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Financial Safety Boundaries (Strict Fail-Closed Defaults)
STAGE_1_SAFETY_LOCK=true
LIVE_EXECUTION_ENABLED=false

# Next.js Frontend Configuration (Canonical: NEXT_PUBLIC_API_BASE)
# Leave empty for same-origin (/api) reverse-proxy routing behind NGINX, or supply external origin
NEXT_PUBLIC_API_BASE=
